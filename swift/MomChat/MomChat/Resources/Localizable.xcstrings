    "chat.failure.declined" : {
      "comment" : "Shown instead of an answer when Apple's safety filter or the model declines the question.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can't answer that one here. Your midwife, doctor or pediatrician can help with it."
          }
        }
      }
    },
    "chat.failure.modelUnavailable" : {
      "comment" : "Shown when the on-device model is turned off or updating.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The assistant isn't available right now. Check that Apple Intelligence is on, then try again."
          }
        }
      }
    },
    "chat.failure.retry" : {
      "comment" : "Button under a failed answer: asks the same question again.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again"
          }
        }
      }
    },
    "chat.failure.retryable" : {
      "comment" : "Shown when an answer failed for an unexpected reason. A \"Try again\" button follows.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong with that answer."
          }
        }
      }
    },
    "chat.failure.tooLong" : {
      "comment" : "Shown instead of an answer when one message is too long for the model to read, even after older messages were summarized.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That message is too long for me to read in one go. Try asking in a few shorter messages."
          }
        }
      }
    },
    "chat.failure.unsupportedLanguage" : {
      "comment" : "Shown instead of an answer when the question is in a language the model does not support.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can only answer in English for now. Could you ask again in English?"
          }
        }
      }
    },
    "chat.freshStart.back" : {
      "comment" : "Button under the fresh-start notice: reopens the chat she had before the app started a new one.",
