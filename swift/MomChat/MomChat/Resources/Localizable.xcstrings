        }
      }
    },
    "chat.freshStart.notice" : {
      "comment" : "Shown at the top of a new, empty chat that the app opened by itself because the previous one had been quiet for 6+ hours (e.g. the app was left open overnight). \"Chats\" is the list of past chats, opened from the top-left button.",
