    "deviceCheck.notEligible.message" : {
      "comment" : "Apple Intelligence check screen: honest explanation for unsupported phones.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MomChat needs Apple Intelligence, which works on iPhone 15 Pro and newer. Everything happens on your phone, so there's no online version we could offer instead."
          }
        }
      }
    },
    "deviceCheck.notEligible.title" : {
      "comment" : "Apple Intelligence check screen: title on phones older than iPhone 15 Pro.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone can't run MomChat"
          }
        }
      }
    },
    "deviceCheck.notEnabled.message" : {
      "comment" : "Apple Intelligence check screen: steps to turn Apple Intelligence on. 'Apple Intelligence & Siri' is the Settings item name.",
