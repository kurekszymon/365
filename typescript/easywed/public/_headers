# Cloudflare Pages reads _headers from the deploy root. Everything in public/
# is copied verbatim into .output/public, which is the directory Pages serves -
# same path robots.txt takes.
#
# The CSP is Report-Only on purpose. Violations show up in the browser console
# (there is no report collector wired up) and block nothing. Read the notes
# under connect-src before switching the header name to Content-Security-Policy.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://iteuwqbqrulwdwyjohtx.supabase.co wss://iteuwqbqrulwdwyjohtx.supabase.co https://eu.i.posthog.com https://eu-assets.i.posthog.com https://openrouter.ai; manifest-src 'self'; upgrade-insecure-requests
