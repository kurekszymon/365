{
  "name": "easywed-video",
  "version": "1.0.0",
  "description": "Remotion product demo for easywed.app",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.502",
    "@remotion/google-fonts": "^4.0.502",
    "@remotion/tailwind-v4": "4.0.502",
    "@remotion/transitions": "^4.0.502",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.502",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.502",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "dev:en": "REMOTION_LANG=en remotion studio",
    "render": "remotion render easywed-demo out/${REMOTION_LANG:-pl}/easywed-demo.mp4",
    "render:vertical": "remotion render easywed-demo-vertical out/${REMOTION_LANG:-pl}/easywed-demo-vertical.mp4",
    "render:gif": "remotion render easywed-demo out/${REMOTION_LANG:-pl}/easywed-demo.gif --codec=gif --every-nth-frame=2 --width=960",
    "render:teaser": "remotion render easywed-teaser out/${REMOTION_LANG:-pl}/easywed-teaser.mp4",
    "render:teaser:vertical": "remotion render easywed-teaser-vertical out/${REMOTION_LANG:-pl}/easywed-teaser-vertical.mp4",
    "render:import-excel": "remotion render easywed-import out/${REMOTION_LANG:-pl}/easywed-import.mp4",
    "render:import-excel:vertical": "remotion render easywed-import-vertical out/${REMOTION_LANG:-pl}/easywed-import-vertical.mp4",
    "render:kitchen-report": "remotion render easywed-report out/${REMOTION_LANG:-pl}/easywed-report.mp4",
    "render:kitchen-report:vertical": "remotion render easywed-report-vertical out/${REMOTION_LANG:-pl}/easywed-report-vertical.mp4",
    "render:kids-count": "remotion render easywed-kids out/${REMOTION_LANG:-pl}/easywed-kids.mp4",
    "render:kids-count:vertical": "remotion render easywed-kids-vertical out/${REMOTION_LANG:-pl}/easywed-kids-vertical.mp4",
    "render:to-scale": "remotion render easywed-scale out/${REMOTION_LANG:-pl}/easywed-scale.mp4 --scale=0.5",
    "render:to-scale:poster": "remotion still easywed-scale out/${REMOTION_LANG:-pl}/easywed-scale-poster.png --frame=0 --scale=0.5",
    "render:seat-swap": "remotion render easywed-swap out/${REMOTION_LANG:-pl}/easywed-swap.mp4 --scale=0.5",
    "render:seat-swap:poster": "remotion still easywed-swap out/${REMOTION_LANG:-pl}/easywed-swap-poster.png --frame=0 --scale=0.5",
    "render:seat-swap-cut": "remotion render easywed-swap-cut out/${REMOTION_LANG:-pl}/easywed-swap-cut.mp4",
    "render:seat-swap-cut:vertical": "remotion render easywed-swap-cut-vertical out/${REMOTION_LANG:-pl}/easywed-swap-cut-vertical.mp4",
    "render:odd-room": "remotion render easywed-shape out/${REMOTION_LANG:-pl}/easywed-shape.mp4 --scale=0.5",
    "render:odd-room:poster": "remotion still easywed-shape out/${REMOTION_LANG:-pl}/easywed-shape-poster.png --frame=0 --scale=0.5",
    "render:walkthrough-long": "remotion render easywed-walkthrough out/${REMOTION_LANG:-pl}/easywed-walkthrough.mp4",
    "render:walkthrough-long:vertical": "remotion render easywed-walkthrough-vertical out/${REMOTION_LANG:-pl}/easywed-walkthrough-vertical.mp4",
    "render:all": "npm run render && npm run render:vertical && npm run render:gif && npm run render:teaser && npm run render:teaser:vertical && npm run render:import-excel && npm run render:import-excel:vertical && npm run render:kitchen-report && npm run render:kitchen-report:vertical && npm run render:kids-count && npm run render:kids-count:vertical && npm run render:to-scale && npm run render:to-scale:poster && npm run render:seat-swap && npm run render:seat-swap:poster && npm run render:seat-swap-cut && npm run render:seat-swap-cut:vertical && npm run render:odd-room && npm run render:odd-room:poster && npm run render:walkthrough-long && npm run render:walkthrough-long:vertical",
    "render:all:vertical": "npm run render && npm run render:vertical && npm run render:gif && npm run render:teaser && npm run render:teaser:vertical && npm run render:import-excel && npm run render:import-excel:vertical && npm run render:kitchen-report && npm run render:kitchen-report:vertical",
    "render:all:en": "REMOTION_LANG=en npm run render:all",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
