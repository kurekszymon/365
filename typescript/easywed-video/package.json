{
  "name": "easywed-video",
  "version": "1.0.0",
  "description": "Remotion product demo for easywed.app",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.502",
    "@remotion/google-fonts": "^4.0.502",
    "@remotion/tailwind-v4": "4.0.502",
    "@remotion/transitions": "^4.0.502",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.502",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.502",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render easywed-demo out/easywed-demo.mp4",
    "render:vertical": "remotion render easywed-demo-vertical out/easywed-demo-vertical.mp4",
    "render:gif": "remotion render easywed-demo out/easywed-demo.gif --codec=gif --every-nth-frame=2 --width=960",
    "render:teaser": "remotion render easywed-teaser out/easywed-teaser.mp4",
    "render:teaser:vertical": "remotion render easywed-teaser-vertical out/easywed-teaser-vertical.mp4",
    "render:import-excel": "remotion render easywed-import out/easywed-import.mp4",
    "render:import-excel:vertical": "remotion render easywed-import-vertical out/easywed-import-vertical.mp4",
    "render:kitchen-report": "remotion render easywed-report out/easywed-report.mp4",
    "render:kitchen-report:vertical": "remotion render easywed-report-vertical out/easywed-report-vertical.mp4",
    "render:to-scale": "remotion render easywed-scale out/easywed-scale.mp4 --scale=0.5",
    "render:to-scale:poster": "remotion still easywed-scale out/easywed-scale-poster.png --frame=0 --scale=0.5",
    "render:all": "npm run render && npm run render:vertical && npm run render:gif && npm run render:teaser && npm run render:teaser:vertical && npm run render:import-excel && npm run render:import-excel:vertical && npm run render:kitchen-report && npm run render:kitchen-report:vertical && npm run render:to-scale && npm run render:to-scale:poster",
    "render:all:vertical": "npm run render && npm run render:vertical && npm run render:gif && npm run render:teaser && npm run render:teaser:vertical && npm run render:import-excel && npm run render:import-excel:vertical && npm run render:kitchen-report && npm run render:kitchen-report:vertical",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
