---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

interface Props {
	/** On the home page the site title is the page's h1. */
	home?: boolean;
}

const { home = false } = Astro.props;
const Title = home ? "h1" : "p";
---

<header class="wrap">
	<Title class="site-title">
		<a href="/">{SITE_TITLE}</a>
	</Title>
	<HeaderLink href="/about">about</HeaderLink>
</header>

<style>
	header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 2.5rem;
		padding-bottom: 1.5rem;
		font-size: 0.95rem;
	}
	.site-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.site-title a {
		color: inherit;
		text-decoration: none;
	}
	.site-title a:hover {
		color: var(--accent);
	}
</style>
