---
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Render the site title as the page h1 and show the tagline. */
	home?: boolean;
}

const { title, description, image, home = false } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<Header home={home} />
		<main class="wrap">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		display: flex;
		min-height: 100vh;
		flex-direction: column;
	}
	main {
		flex: 1;
		padding-bottom: 3rem;
	}
</style>
